# Copy this file to .env.local and fill in your real key for local `vercel dev`.
# Never commit .env.local — it's already in .gitignore.

RESEND_API_KEY=re_your_api_key_here

# Optional: override the sender once you've verified a domain in Resend.
# Until a domain is verified, Resend's shared onboarding@resend.dev address
# can only deliver to the email address your Resend account was signed up with.
# RESEND_FROM="Reppstar Technologies <hello@reppstar.com>"
